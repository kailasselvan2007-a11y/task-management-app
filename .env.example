# TaskFlow Full-Stack Environment Configuration

# MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Secret Key for authenticating protected routes
JWT_SECRET=taskflow_jwt_super_secret_signing_key_replace_in_production

# Backend Server Port (defaults to 3000 in AI Studio or 5000 in standalone backend)
PORT=3000

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
